          "now_ms": 11000,
          "request": { "renew": { "incarnation": 2, "fencing_token": 2, "claimant": 10 } },
          "expect": { "kind": "rejected_fencing_conflict", "expected": 1, "got": 2 },
          "expect_slot": { "leased_token": 1, "leased_claimant": 10, "last_fencing_token": 1 }
        },
        {
          "now_ms": 11000,
          "request": { "renew": { "incarnation": 1, "fencing_token": 1, "claimant": 20 } },
          "expect": { "kind": "rejected_fencing_conflict", "expected": 1, "got": 1 },
          "expect_slot": { "leased_token": 1, "leased_claimant": 10, "last_fencing_token": 1 }
        }
      ]
    },
    {
      "name": "a_stale_claimant_renewing_after_a_takeover_is_fenced",
      "skew_ms": 5000,
      "initial": {
        "lease": { "incarnation": 2, "fencing_token": 2, "claimant": 20 },
