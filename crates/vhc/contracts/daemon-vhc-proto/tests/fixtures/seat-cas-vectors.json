    {
      "name": "release_tombstones_the_floor_and_the_next_claim_bids_floor_plus_one",
      "skew_ms": 5000,
      "initial": {
        "lease": { "incarnation": 4, "fencing_token": 4, "claimant": 10 },
        "last_fencing_token": 4
      },
      "steps": [
        {
          "now_ms": 2000,
          "request": { "release": { "incarnation": 4, "fencing_token": 4, "claimant": 10 } },
          "expect": { "kind": "accepted" },
          "expect_slot": { "leased_token": null, "leased_claimant": null, "last_fencing_token": 4 }
        },
        {
          "now_ms": 3000,
          "request": { "claim": { "incarnation": 4, "fencing_token": 4, "claimant": 20 } },
          "expect": { "kind": "rejected_fencing_conflict", "expected": 5, "got": 4 },
          "expect_slot": { "leased_token": null, "leased_claimant": null, "last_fencing_token": 4 }
        },
        {
          "now_ms": 3000,
          "request": {
            "claim": {
              "incarnation": 5,
              "fencing_token": 5,
              "claimant": 20,
              "issued_at_ms": 3000,
              "expires_at_ms": 33000
            }
          },
          "expect": { "kind": "accepted" },
          "expect_slot": { "leased_token": 5, "leased_claimant": 20, "last_fencing_token": 5 }
        }
      ]
    },
    {
